# Copy this file to .env in the backend folder, then fill in your provider credentials.
BRGY_GMAIL_USERNAME=
BRGY_GMAIL_APP_PASSWORD=
BRGY_GMAIL_FROM_NAME=Barangay Bagong Bayan I
# Optional public HTTPS backend URL for recipients to accept invitations remotely.
# If omitted, invitation links use the address of the current backend request.
BRGY_ADMIN_INVITATION_URL=
