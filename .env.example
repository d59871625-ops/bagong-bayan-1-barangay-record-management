# Local development only; never use VITE_ADMIN_PASSWORD for production authentication.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=your_admin_password_here
# Development defaults. Production builds ignore loopback API URLs and use /backend on the current site.
VITE_BACKEND_API_URL=http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000/api.php

